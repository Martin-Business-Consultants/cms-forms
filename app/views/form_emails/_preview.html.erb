<%# locals: (email:) %>
<%# Preview: the editor's form, as it is now (saved or not), drawn for a
    made-up submission into a half-width sheet's frame. The button posts the
    form there (form_emails/previews) rather than saving it. %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
  <button type="submit" class="<%= ui(:button, :small) %>" formaction="<%= form_email_preview_path(form_slug: email.form.slug, email_kind: email.kind) %>"
          formtarget="form_email_preview_frame" formnovalidate data-turbo="false" data-action="dialog#open">Preview</button>
  <dialog class="<%= ui(:sheet, "dialog--sheet-half") %>" data-dialog-target="dialog" aria-label="Preview" closedby="any">
    <header class="flex items-center justify-between gap-4">
      <h2 class="text-lg font-semibold text-gray-900">Preview</h2>
      <button type="button" class="<%= ui(:button, :plain, :small) %>" data-action="dialog#close">Close</button>
    </header>
    <p class="<%= ui(:help) %>">
      For a made-up submission.
      <% if email.site_template_current? %>
        In the site’s template, as it’s sent now.
      <% else %>
        In the CMS’s layout; the site’s own design shows once its build has made a template of these blocks.
      <% end %>
    </p>
    <iframe name="form_email_preview_frame" class="min-h-0 w-full flex-1 rounded-lg border border-gray-200 bg-gray-50" title="Email preview"></iframe>
  </dialog>
</div>
