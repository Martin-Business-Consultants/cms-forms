<%# locals: (email:) %>
<%# Preview: the editor's form, as it is now (saved or not), drawn for a
    made-up submission into a sheet's frame. The button posts the form there
    (form_emails/previews) rather than saving it. %>
<div class="contents" data-controller="rune-dialog" data-action="keydown.esc->rune-dialog#close:stop">
  <button type="submit" class="btn btn--secondary btn--sm" formaction="<%= form_email_preview_path(form_slug: email.form.slug, email_kind: email.kind) %>"
          formtarget="form_email_preview_frame" formnovalidate data-turbo="false" data-action="rune-dialog#open">Preview</button>
  <dialog class="dialog sheet forms-preview-sheet" data-rune-dialog-target="dialog" data-action="click->rune-dialog#backdrop" aria-label="Preview" closedby="any">
    <div class="dialog__box forms-preview-sheet__box">
      <header class="dialog__header">
        <h2 class="dialog__title">Preview</h2>
        <%= icon_button "close", label: "Close", data: { action: "rune-dialog#close" } %>
      </header>
      <p class="dialog__hint">
        For a made-up submission.
        <% if email.site_template_current? %>
          In the site’s template, as it’s sent now.
        <% else %>
          In the CMS’s layout; the site’s own design shows once its build has made a template of these blocks.
        <% end %>
      </p>
      <iframe name="form_email_preview_frame" class="forms-email-preview" title="Email preview"></iframe>
    </div>
  </dialog>
</div>
