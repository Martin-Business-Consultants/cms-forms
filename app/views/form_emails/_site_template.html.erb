<%# locals: (email:) %>
<%# Whether the Astro site has built this email's template
    (FormEmail::SiteTemplate), and so which design goes out. %>
<% case email.site_template_status %>
<% when :theme %>
  <p class="button-row"><%= status_tag "ready" %> The website’s theme designs it.</p>
  <p class="field__hint">Drawn from these blocks each time it’s sent, so a change goes out with the next one.</p>
<% when :current %>
  <p class="button-row"><%= status_tag "ready" %> The site’s design is sent.</p>
  <p class="field__hint">Built from these blocks, received <%= time_ago_tag email.site_template_received_at %>.</p>
<% when :stale %>
  <p class="button-row"><%= status_tag "pending" %> Waiting for the site to rebuild.</p>
  <p class="field__hint">The site’s template is from earlier blocks, so the CMS’s layout is sent until the next build sends a new one. Saving a change schedules that build.</p>
<% else %>
  <p class="button-row"><%= status_tag "none" %> No template from the site yet.</p>
  <p class="field__hint">Sent in the CMS’s layout. Add the Astro integration’s email route and its build sends one (integrations/astro, “Form emails”).</p>
<% end %>
