<% title = @email.notification? ? "Notification email" : "Confirmation email" %>
<% @page_title = @form.title + " — " + title %>
<%= parent_page @form.title, edit_form_path(@form.slug) %>
<% email_fields = Array(@form.fields).select { |f| f.is_a?(Hash) && f["type"] == "email" } %>
<% sibling = @email.notification? ? "confirmation" : "notification" %>

<% content_for :page_actions do %>
  <%= link_to (sibling == "confirmation" ? "Confirmation email" : "Notification email"), edit_form_email_path(form_slug: @form.slug, kind: sibling), class: ui(:button) %>
<% end %>
<%= render "layouts/shared/page_header", title: title,
      description: (@email.notification? ? "Sent to your people on each new submission to “#{@form.title}”." : "An automatic reply to whoever submitted “#{@form.title}”, at the address they gave.") %>
<%= render "layouts/shared/errors", record: @email %>

<%# The email as content: its subject and blocks in the main column (the
    content editor, with FormEmail::BlockTypes); sending, the Astro site's
    template and the placeholders down the side. %>
<%= form_with model: @email, url: form_email_path(form_slug: @form.slug, kind: @email.kind), method: :patch, scope: :form_email,
      id: "form_email_form", class: "flex flex-col gap-6 lg:flex-row lg:items-start" do |form| %>
  <div class="flex min-w-0 flex-1 flex-col gap-6">
    <div>
      <label class="sr-only" for="form_email_subject">Subject</label>
      <%= form.text_field :subject, class: "w-full rounded-none border-0 border-b bg-transparent px-0 pb-3 pt-0 text-3xl font-semibold tracking-tight", placeholder: "Subject line" %>
    </div>

    <section class="<%= ui(:panel) %>">
      <h2 class="<%= ui(:heading, "border-b border-gray-200 px-5 py-3.5") %>">Content</h2>
      <div class="p-3 sm:p-5">
        <%= with_content_block_types(FormEmail::BlockTypes.all) do %>
          <%= render "content_form/blocks", blocks: @email.content_blocks, scope: content_scope("form_email")["blocks"], depth: 1,
                record: @email, new_block_url: new_form_email_block_path %>
        <% end %>
      </div>
    </section>
  </div>

  <aside class="flex shrink-0 flex-col gap-4 lg:w-80">
    <%= postbox "form-email-send", "Send" do %>
      <label class="flex items-center gap-2">
        <%= form.check_box :enabled %>
        <span class="<%= ui(:label) %>">Send this email</span>
      </label>
      <% if @email.notification? then %>
        <%= render "form_emails/recipients", email: @email %>
      <% else %>
        <%= settings_field "Send to the address in", hint: "Blank uses the form’s first email field." do %>
          <%= form.select :from_field, email_fields.map { |f| [f["label"].to_s + " (" + f["name"].to_s + ")", f["name"]] }, { include_blank: "The first email field" }, class: "w-full" %>
        <% end %>
      <% end %>
      <div class="flex flex-wrap gap-2">
        <%= render "form_emails/preview", email: @email %>
        <button type="submit" form="form_email_test_form" class="<%= ui(:button, :small) %>" title="Send the saved email, for a made-up submission, to <%= Current.user.email %>">Send me a test</button>
      </div>
      <div class="-mx-5 -mb-5 flex justify-end rounded-b-xl border-t border-gray-200 bg-gray-50 px-5 py-3">
        <%= form.button "Save email", class: ui(:button, :primary) %>
      </div>
    <% end %>

    <%= postbox "form-email-site-template", "Site template" do %>
      <%= render "form_emails/site_template", email: @email %>
    <% end %>

    <%= postbox "form-email-placeholders", "Placeholders" do %>
      <p class="<%= ui(:help) %>">Any text in a block can take these.</p>
      <ul class="flex flex-col gap-2 text-sm">
        <% Array(@form.fields).each_with_index do |field, index| %>
          <%# herb:key index %>
          <li class="flex flex-wrap items-baseline gap-x-2"><code class="whitespace-nowrap font-mono text-xs text-gray-900">{{<%= field["name"] %>}}</code> <span class="text-gray-500"><%= field["label"] %></span></li>
        <% end %>
        <li class="flex flex-wrap gap-x-2 gap-y-1">
          <% %w[form_title submission_id submitted_at ip].each do |token| %>
            <%# herb:key token %>
            <code class="whitespace-nowrap font-mono text-xs text-gray-900">{{<%= token %>}}</code>
          <% end %>
        </li>
      </ul>
    <% end %>
  </aside>
<% end %>
<%= form_with url: form_email_test_path(form_slug: @form.slug, email_kind: @email.kind), id: "form_email_test_form", hidden: true do %><% end %>
<%= plugin_slots(:content_form) %>
<%= render "content_form/postbox_state" %>
