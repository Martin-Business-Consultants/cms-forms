<% @page_title = @form.title + " #" + @submission.id.to_s %>
<%= parent_page @form.title, form_path(@form.slug) %>

<% if Current.user.can?("submissions:delete") %>
  <% content_for :page_actions do %>
    <%= render "layouts/shared/delete_dialog", name: "this submission", path: form_submission_path(@form.slug, @submission),
          message: "The submission and its files are deleted. This can’t be undone." %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>
<%# The header shows no description, so when and where it came from is said here. %>
<p class="help">Received <%= time_ago_in_words(@submission.created_at) %> ago<%= " from #{@submission.ip}" if @submission.ip.present? %>.</p>

<div class="stack stack--lg measure--lg">
  <section class="panel">
    <h2 class="heading editor__section-title">Answers</h2>
    <dl class="forms-answers">
      <% @submission.data.to_h.each do |key, value| %>
        <%# herb:key key %>
        <div>
          <dt><%= submission_label(@form, key) %></dt>
          <dd><%= submission_value(value) %></dd>
        </div>
      <% end %>
    </dl>
    <% if @submission.data.blank? %>
      <p class="empty-state">An empty submission.</p>
    <% end %>
  </section>

  <% if @submission.files.attached? %>
    <section class="panel">
      <h2 class="heading editor__section-title">Files</h2>
      <ul class="forms-list">
        <% @submission.files.each do |file| %>
          <%# herb:key file.id %>
          <li>
            <%= link_to file.filename.to_s, rails_blob_path(file, disposition: "attachment"), class: "link" %>
            <span class="text-small text-muted"><%= number_to_human_size(file.byte_size) %><%= " · " + file.metadata["field"].to_s if file.metadata["field"].present? %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @submission.meta.present? %>
    <%= postbox "submission-request", "Request details", open: false, flush: true do %>
      <dl class="forms-answers forms-answers--meta">
        <% @submission.meta.to_h.each do |key, value| %>
          <%# herb:key key %>
          <div>
            <dt><%= key %></dt>
            <dd><%= value.is_a?(Hash) || value.is_a?(Array) ? value.to_json : value.to_s %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  <% end %>
</div>
<%= render "content_form/postbox_state" %>
