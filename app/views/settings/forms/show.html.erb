<% @page_title = "Forms" %>
<% can_write = Current.user.can?("forms:write") %>

<%= render "layouts/shared/page_header", title: "Forms" %>
<% content_for :settings_aside do %>
  <%= render "settings/save_box", form: "settings_form", capability: "forms:write" %>
<% end %>

<%= form_with url: settings_forms_path, id: "settings_form", method: :patch, scope: :settings do |form| %>
  <%= tag.fieldset class: "space-y-6", disabled: !can_write do %>
    <section class="<%= ui(:panel, "space-y-5 p-6") %>">
      <div class="space-y-1">
        <h2 class="<%= ui(:heading) %>">Sender</h2>
        <p class="text-sm text-gray-500">How form notifications and confirmations are signed.</p>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <%= settings_field "From name" do %>
          <%= form.text_field :from_name, value: @settings["from_name"], class: "w-full", placeholder: "Old Mill Forms" %>
        <% end %>
        <%= settings_field "From address" do %>
          <%= form.email_field :from_email, value: @settings["from_email"], class: "w-full", placeholder: "forms@example.com" %>
        <% end %>
      </div>
    </section>

    <section class="<%= ui(:panel, "space-y-5 p-6") %>">
      <div class="space-y-1">
        <h2 class="<%= ui(:heading) %>">Spam protection</h2>
        <p class="text-sm text-gray-500">A submission has to pass this check before it reaches the inbox. The site shows the widget with the site key.</p>
      </div>
      <%= settings_field "Check with" do %>
        <%= form.select :captcha_provider, Settings::FormsController::CAPTCHA_PROVIDERS.invert.to_a, { selected: @settings["captcha_provider"] }, class: "w-full" %>
      <% end %>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <%= settings_field "Turnstile site key" do %>
          <%= form.text_field :turnstile_site_key, value: @settings["turnstile_site_key"], class: "w-full font-mono", autocomplete: "off" %>
        <% end %>
        <%= settings_field "Turnstile secret key" do %>
          <%= form.password_field :turnstile_secret_key, class: "w-full font-mono", autocomplete: "new-password", placeholder: (@secrets_set["turnstile_secret_key"] ? "Saved — leave blank to keep" : ""), data: { "1p-ignore": true } %>
        <% end %>
        <%= settings_field "reCAPTCHA site key" do %>
          <%= form.text_field :recaptcha_site_key, value: @settings["recaptcha_site_key"], class: "w-full font-mono", autocomplete: "off" %>
        <% end %>
        <%= settings_field "reCAPTCHA secret key" do %>
          <%= form.password_field :recaptcha_secret_key, class: "w-full font-mono", autocomplete: "new-password", placeholder: (@secrets_set["recaptcha_secret_key"] ? "Saved — leave blank to keep" : ""), data: { "1p-ignore": true } %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
