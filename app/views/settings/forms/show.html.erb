<% @page_title = "Forms" %>
<% can_write = Current.user.can?("forms:write") %>

<%= render "layouts/shared/page_header", title: "Forms" %>
<% content_for :settings_aside do %>
  <%= render "settings/save_box", form: "settings_form", capability: "forms:write" %>
<% end %>

<%= form_with url: settings_forms_path, id: "settings_form", method: :patch, scope: :settings do |form| %>
  <%= tag.fieldset class: "stack stack--lg", disabled: !can_write do %>
    <section class="card">
      <div class="card__head">
        <h2 class="card__title">Sender</h2>
        <p class="card__hint">Who every email from the site comes from: form notifications and confirmations, and the CMS's own (password resets, collection notifications). Which server sends them is Settings › Email delivery.</p>
      </div>
      <div class="field-row">
        <%= settings_field "From name" do %>
          <%= form.text_field :from_name, value: @settings["from_name"], placeholder: "Old Mill Forms" %>
        <% end %>
        <%= settings_field "From address" do %>
          <%= form.email_field :from_email, value: @settings["from_email"], placeholder: "forms@example.com" %>
        <% end %>
      </div>
    </section>

    <section class="card">
      <div class="card__head">
        <h2 class="card__title">Keeping submissions</h2>
        <p class="card__hint">Submissions hold what people tell you about themselves. Keep them only as long as you need them: older ones are deleted each night, with their files. Someone’s data on request: Submissions › Personal data.</p>
      </div>
      <%= settings_field "Keep submissions for" do %>
        <%= form.select :retention_days, FormSubmission::RETENTION_CHOICES.invert.to_a, { selected: @settings["retention_days"] } %>
      <% end %>
    </section>

    <section class="card">
      <div class="card__head">
        <h2 class="card__title">Spam protection</h2>
        <p class="card__hint">A submission has to pass this check before it reaches the inbox. The site shows the widget with the site key.</p>
      </div>
      <div class="stack" data-controller="forms--captcha-settings">
        <%= settings_field "Check with" do %>
          <%= form.select :captcha_provider, Settings::FormsController::CAPTCHA_PROVIDERS.invert.to_a, { selected: @settings["captcha_provider"] }, data: { "forms--captcha-settings-target": "provider", action: "forms--captcha-settings#show" } %>
        <% end %>
        <%= tag.div class: "stack", hidden: @settings["captcha_provider"] != "turnstile", data: { "forms--captcha-settings-target": "group", provider: "turnstile" } do %>
          <div class="field-row">
            <%= settings_field "Turnstile site key" do %>
              <%= form.text_field :turnstile_site_key, value: @settings["turnstile_site_key"], class: "mono", autocomplete: "off" %>
            <% end %>
            <%= settings_field "Turnstile secret key" do %>
              <%= form.password_field :turnstile_secret_key, class: "mono", autocomplete: "new-password", placeholder: (@secrets_set["turnstile_secret_key"] ? "Saved — leave blank to keep" : ""), data: { "1p-ignore": true } %>
            <% end %>
          </div>
          <%= settings_field "Appearance", hint: "Match the visitor's light or dark setting, or always draw the check light or dark." do %>
            <%= form.select :captcha_theme, Settings::FormsController::CAPTCHA_THEMES.invert.to_a, { selected: @settings["captcha_theme"] } %>
          <% end %>
        <% end %>
        <%= tag.div class: "field-row", hidden: @settings["captcha_provider"] != "recaptcha", data: { "forms--captcha-settings-target": "group", provider: "recaptcha" } do %>
          <%= settings_field "reCAPTCHA site key" do %>
            <%= form.text_field :recaptcha_site_key, value: @settings["recaptcha_site_key"], class: "mono", autocomplete: "off" %>
          <% end %>
          <%= settings_field "reCAPTCHA secret key" do %>
            <%= form.password_field :recaptcha_secret_key, class: "mono", autocomplete: "new-password", placeholder: (@secrets_set["recaptcha_secret_key"] ? "Saved — leave blank to keep" : ""), data: { "1p-ignore": true } %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
