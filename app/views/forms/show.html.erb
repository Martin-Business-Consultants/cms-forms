<% @page_title = @form.title %>
<%= parent_page "Forms", forms_path %>
<% can_delete = Current.user.can?("submissions:delete") %>

<% content_for :page_actions do %>
  <%= link_to "All submissions", submissions_path(form: @form.slug), class: "btn btn--secondary" %>
  <% if Current.user.can?("forms:write") %>
    <%= link_to "Edit form", edit_form_path(@form.slug), class: "btn btn--secondary" %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @form.title,
      description: pluralize(@submission_count, "submission") + " · " + @form.status + " · posts to /api/forms/" + @form.slug + "/submissions" %>

<div class="stack stack--lg">
  <section class="card card--flush">
    <table class="table data-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Received</th>
          <th>Preview</th>
          <th class="data-table__num">Files</th>
        </tr>
      </thead>
      <tbody>
        <% @submissions.each do |submission| %>
          <%# herb:key submission.id %>
          <tr id="<%= dom_id(submission) %>" data-filter-target="item">
            <td class="mono">
              <%= link_to submission.id, form_submission_path(@form.slug, submission), class: "row-link" %>
              <%= render "layouts/shared/row_links", name: "submission #" + submission.id.to_s, edit_path: nil,
                  delete_path: (form_submission_path(@form.slug, submission) if can_delete),
                  delete_message: "The submission and its files are deleted. This can’t be undone." %>
            </td>
            <td><span class="nowrap small muted"><%= time_ago_tag submission.created_at %></span></td>
            <td><span class="muted"><%= submission_preview(submission) %></span></td>
            <td class="data-table__num"><%= submission.files.size %></td>
          </tr>
        <% end %>
        <%= table_empty_row("No submissions yet. The site posts them to /api/forms/#{@form.slug}/submissions#{" once the form is published" unless @form.status == "published"}.", columns: 4) if @submissions.none? %>
      </tbody>
    </table>
    <% if @submission_count > @submissions.size %>
      <p class="card__footer card__footer--bordered forms-footer-note">The latest <%= @submissions.size %>. <%= link_to "See them all", submissions_path(form: @form.slug) %>.</p>
    <% end %>
  </section>

  <section class="card card--flush">
    <h2 class="card__title editor__section-title">Fields</h2>
    <% if Array(@form.fields).any? %>
      <ul class="forms-list">
        <% Array(@form.fields).each_with_index do |field, index| %>
          <%# herb:key index %>
          <li>
            <span class="strong"><%= field["label"] %></span>
            <span class="mono muted"><%= field["name"] %> · <%= field["type"] %><%= " · required" if field["required"] %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty empty--compact">No fields yet.</p>
    <% end %>
  </section>
</div>
