<% @page_title = @form.title %>
<%= parent_page "Forms", forms_path %>
<% can_delete = Current.user.can?("submissions:delete") %>

<% content_for :page_actions do %>
  <%= link_to "All submissions", submissions_path(form: @form.slug), class: ui(:button) %>
  <% if Current.user.can?("forms:write") %>
    <%= link_to "Edit form", edit_form_path(@form.slug), class: ui(:button) %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @form.title,
      description: pluralize(@submission_count, "submission") + " · " + @form.status + " · posts to /api/forms/" + @form.slug + "/submissions" %>

<div class="flex flex-col gap-6">
  <section class="<%= ui(:panel, "overflow-x-auto") %>">
    <table class="data-table <%= ui(:table) %>">
      <thead>
        <tr>
          <th class="<%= ui(:th) %>">#</th>
          <th class="<%= ui(:th) %>">Received</th>
          <th class="<%= ui(:th) %>">Preview</th>
          <th class="<%= ui(:th, "text-right") %>">Files</th>
        </tr>
      </thead>
      <tbody>
        <% @submissions.each do |submission| %>
          <%# herb:key submission.id %>
          <tr id="<%= dom_id(submission) %>" class="hover:bg-gray-50" data-filter-target="item">
            <td class="<%= ui(:td, "font-mono") %>">
              <%= link_to submission.id, form_submission_path(@form.slug, submission), class: "font-medium text-gray-900 hover:underline" %>
              <%= render "layouts/shared/row_links", name: "submission #" + submission.id.to_s, edit_path: nil,
                  delete_path: (form_submission_path(@form.slug, submission) if can_delete),
                  delete_message: "The submission and its files are deleted. This can’t be undone." %>
            </td>
            <td class="<%= ui(:td) %>"><span class="whitespace-nowrap text-xs text-gray-500"><%= time_ago_tag submission.created_at %></span></td>
            <td class="<%= ui(:td) %>"><span class="text-gray-500"><%= submission_preview(submission) %></span></td>
            <td class="<%= ui(:td, "text-right tabular-nums") %>"><%= submission.files.size %></td>
          </tr>
        <% end %>
        <%= table_empty_row("No submissions yet. The site posts them to /api/forms/#{@form.slug}/submissions#{" once the form is published" unless @form.status == "published"}.", columns: 4) if @submissions.none? %>
      </tbody>
    </table>
    <% if @submission_count > @submissions.size %>
      <p class="px-3 py-2.5 text-sm text-gray-500">The latest <%= @submissions.size %>. <%= link_to "See them all", submissions_path(form: @form.slug), class: ui(:link) %>.</p>
    <% end %>
  </section>

  <section class="<%= ui(:panel) %>">
    <h2 class="<%= ui(:heading, "border-b border-gray-200 px-5 py-3.5") %>">Fields</h2>
    <% if Array(@form.fields).any? %>
      <ul class="divide-y divide-gray-100">
        <% Array(@form.fields).each_with_index do |field, index| %>
          <%# herb:key index %>
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-5 py-2.5 text-sm">
            <span class="font-medium text-gray-900"><%= field["label"] %></span>
            <span class="font-mono text-xs text-gray-500"><%= field["name"] %> · <%= field["type"] %><%= " · required" if field["required"] %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-5 py-12 text-center text-sm text-gray-500">No fields yet.</p>
    <% end %>
  </section>
</div>
