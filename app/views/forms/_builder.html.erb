<%# locals: (form:) %>
<%# The form builder's fields, after Payload's form builder: each field a row
    (drag handle, type, name, its moves) previewing it as the site shows it,
    in order, above the submit button; the palette under them adds a field,
    clicked (at the end) or dragged into place. Picking a row opens its
    settings in a sheet (forms/_field_sheet). Rows post as
    form[fields][<row id>][…] for FormFields to read back, in their order. %>
<% fields = Array(form.fields).map { it.is_a?(Hash) ? it : {} } %>
<section class="panel">
  <h2 class="heading editor__section-title">Fields</h2>
  <div class="forms-builder__canvas" data-forms--builder-target="dropzone">
    <ol class="stack stack--sm" data-forms--builder-target="canvas">
      <% fields.each_index do |index| %>
        <%# herb:key index %>
        <%= render "forms/field_card", key: "f" + index.to_s %>
      <% end %>
    </ol>
    <%= tag.p class: "forms-builder__empty", data: { forms__builder_target: "empty" }, hidden: fields.any? do %>
      No fields yet. Add one from below, or drag it here.
    <% end %>
    <div class="forms-builder__submit">
      <span class="btn btn--primary" data-forms--builder-target="submitPreview"><%= form.submit_label.presence || "Submit" %></span>
    </div>
  </div>

  <div class="forms-builder__palette">
    <div class="cluster cluster--between">
      <h3 class="text-medium">Add a field</h3>
      <span class="help">Click one to add it at the end, or drag it into place.</span>
    </div>
    <% form_field_palette.each do |group, types| %>
      <%# herb:key group %>
      <div class="forms-builder__group">
        <span class="forms-builder__group-name"><%= group %></span>
        <div class="cluster cluster--xs">
          <% types.each do |type, label, icon| %>
            <%# herb:key type %>
            <button type="button" class="btn btn--sm forms-builder__type" draggable="true" data-type="<%= type %>" data-label="<%= label %>"
                    data-action="forms--builder#add dragstart->forms--builder#paletteDragStart dragend->forms--builder#dragEnd">
              <%= icon_tag icon %>
              <span><%= label %></span>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
    <p class="help">A spam trap (<code class="code"><%= Form::HONEYPOT_FIELD %></code>) is added by the site’s renderer, not here.</p>
  </div>

  <template data-forms--builder-target="cardTemplate">
    <%= render "forms/field_card", key: "__KEY__" %>
  </template>
</section>
