<%# locals: (form:) %>
<%# The form builder's fields, after Payload's form builder: each field a row
    (drag handle, type, name, its moves) previewing it as the site shows it,
    in order, above the submit button; the palette under them adds a field,
    clicked (at the end) or dragged into place. Picking a row opens its
    settings in a sheet (forms/_field_sheet). Rows post as
    form[fields][<row id>][…] for FormFields to read back, in their order. %>
<% fields = Array(form.fields).map { it.is_a?(Hash) ? it : {} } %>
<section class="<%= ui(:panel) %>">
  <h2 class="<%= ui(:heading, "border-b border-gray-200 px-5 py-3.5") %>">Fields</h2>
  <div class="space-y-4 p-3 sm:p-5" data-forms--builder-target="dropzone">
    <ol class="flex flex-col gap-2" data-forms--builder-target="canvas">
      <% fields.each_index do |index| %>
        <%# herb:key index %>
        <%= render "forms/field_card", key: "f" + index.to_s %>
      <% end %>
    </ol>
    <%= tag.p class: "rounded-lg border border-dashed border-gray-300 px-4 py-10 text-center text-sm text-gray-500", data: { forms__builder_target: "empty" }, hidden: fields.any? do %>
      No fields yet. Add one from below, or drag it here.
    <% end %>
    <div class="border-t border-dashed border-gray-200 pt-4">
      <span class="<%= ui(:button, :primary, "pointer-events-none") %>" data-forms--builder-target="submitPreview"><%= form.submit_label.presence || "Submit" %></span>
    </div>
  </div>

  <div class="space-y-3 rounded-b-xl border-t border-gray-200 bg-gray-50 px-5 py-4">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="text-sm font-medium text-gray-900">Add a field</h3>
      <span class="<%= ui(:help) %>">Click one to add it at the end, or drag it into place.</span>
    </div>
    <% form_field_palette.each do |group, types| %>
      <%# herb:key group %>
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <span class="text-xs text-gray-500 shrink-0 sm:w-28"><%= group %></span>
        <div class="flex flex-wrap gap-1.5">
          <% types.each do |type, label, icon| %>
            <%# herb:key type %>
            <button type="button" class="<%= ui(:button, :small, "cursor-grab") %>" draggable="true" data-type="<%= type %>" data-label="<%= label %>"
                    data-action="forms--builder#add dragstart->forms--builder#paletteDragStart dragend->forms--builder#dragEnd">
              <%= icon_tag icon, class: "size-4 text-gray-500" %>
              <span><%= label %></span>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
    <p class="<%= ui(:help) %>">A spam trap (<code class="font-mono"><%= Form::HONEYPOT_FIELD %></code>) is added by the site’s renderer, not here.</p>
  </div>

  <template data-forms--builder-target="cardTemplate">
    <%= render "forms/field_card", key: "__KEY__" %>
  </template>
</section>
