<%# locals: (field:, key:) %>
<%# One field's settings in the builder's sheet (forms/_field_sheet), shown
    while its row is picked, split as Gravity Forms splits them: General,
    Appearance, Advanced. Which tab and which settings show (they depend on
    the type) is forms/forms.css's, so those blocks carry no display class. %>
<% name = "form[fields][" + key + "]" %>
<div class="form-settings" data-key="<%= key %>" data-forms--builder-target="settings" hidden
     data-action="input->forms--builder#changed change->forms--builder#changed">
  <div class="form-settings__tab" data-tab="general">
    <label class="field">
      <span class="label">Field label</span>
      <%= text_field_tag name + "[label]", field["label"], id: nil, autocomplete: "off", required: true, data: { role: "label" } %>
    </label>
    <label class="field">
      <span class="label">Description</span>
      <%= text_field_tag name + "[help]", field["help"], id: nil, placeholder: "Shown under the field", data: { role: "help" } %>
    </label>
    <div data-for="choices">
      <label class="field">
        <span class="label">Choices</span>
        <%= text_area_tag name + "[options]", FormFields.options_text(field), id: nil, rows: 4, class: "text-mono", data: { role: "options" } %>
        <span class="help">One per line: <code class="code">value | label</code>, or just the label.</span>
      </label>
      <label class="field">
        <span class="label">Choices from a collection</span>
        <%= select_tag name + "[options_collection]", form_choice_collection_options(field["options_collection"]), id: nil, data: { role: "options_collection" } %>
        <span class="help">Its published entries come first, in order, then the choices above. A new entry joins the list as it's published.</span>
      </label>
    </div>
    <div data-for="file">
      <label class="field">
        <span class="label">Accepted files</span>
        <%= text_field_tag name + "[accept]", field["accept"], id: nil, class: "text-mono", placeholder: ".pdf,.doc,image/*" %>
      </label>
      <label class="field">
        <span class="label">Largest file</span>
        <%= text_field_tag name + "[max_size]", FormFields.max_size_text(field), id: nil, placeholder: "10 MB" %>
      </label>
      <label class="choice">
        <%= check_box_tag name + "[multiple]", "1", field["multiple"] == true, id: nil, data: { role: "multiple" } %>
        <span>Several files</span>
      </label>
    </div>
    <label class="choice">
      <%= check_box_tag name + "[required]", "1", field["required"] == true, id: nil, data: { role: "required" } %>
      <span>Required</span>
    </label>
  </div>

  <div class="form-settings__tab" data-tab="appearance">
    <div data-for="text">
      <label class="field">
        <span class="label">Placeholder</span>
        <%= text_field_tag name + "[placeholder]", field["placeholder"], id: nil, data: { role: "placeholder" } %>
      </label>
    </div>
    <p class="text-muted" data-for="no-text">This field has no appearance settings.</p>
  </div>

  <div class="form-settings__tab" data-tab="advanced">
    <label class="field">
      <span class="label">Field type</span>
      <%= select_tag name + "[type]", options_for_select(form_field_type_options, field["type"]), id: nil, data: { role: "type" } %>
    </label>
    <label class="field">
      <span class="label">Field name</span>
      <%= text_field_tag name + "[name]", field["name"], id: nil, class: "text-mono", placeholder: "email",
            autocomplete: "off", spellcheck: false, required: true, data: { role: "name" } %>
      <span class="help">The key the submission stores the answer under. Made from the label until you change it.</span>
    </label>
    <div data-for="text">
      <label class="field">
        <span class="label">Default value</span>
        <%= text_field_tag name + "[default]", field["default"], id: nil, data: { role: "default" } %>
      </label>
    </div>
  </div>

  <%= hidden_field_tag name + "[extra]", FormFields.extra_json(field), id: nil %>
</div>
