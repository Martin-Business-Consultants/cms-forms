<% @page_title = "Edit Form" %>
<%= parent_page "Forms", forms_path %>
<% trash = Current.user.can?("forms:delete") %>

<% content_for :page_actions do %>
  <%= link_to "Add New", new_form_path, class: ui(:button) %>
  <%= link_to "View submissions", form_path(@form.slug), class: ui(:button) %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>
<%= render "layouts/shared/errors", record: @form %>

<%# The form builder, after Payload's: the title, the form's fields as rows
    (each previewing the field as the site shows it, its settings in a sheet)
    with the field palette under them, then its messages, delivery and
    emails in the main column; Publish and where the site posts (its
    permalink) down the side. %>
<%= form_with model: @form, url: form_path(@form.slug), method: :patch, id: "form_editor", class: "flex flex-col gap-6 lg:flex-row lg:items-start",
      data: { controller: "forms--builder", forms__builder_dialog_outlet: "#form_field_sheet" } do |form| %>
  <div class="flex min-w-0 flex-1 flex-col gap-6">
    <div>
      <label class="sr-only" for="form_title">Title</label>
      <%= form.text_field :title, required: true, class: "w-full rounded-none border-0 border-b bg-transparent px-0 pb-3 pt-0 text-3xl font-semibold tracking-tight", placeholder: "Add title" %>
    </div>

    <%= render "forms/builder", form: @form %>

    <%= postbox "form-messages", "Messages" do %>
      <%= settings_field "Submit button" do %>
        <%= form.text_field :submit_label, class: "w-full", required: true, data: { action: "input->forms--builder#submitLabel" } %>
      <% end %>
      <%= settings_field "Success message", hint: "Returned to the site after a submission, for the form to show." do %>
        <%= form.text_area :success_message, rows: 2, class: "w-full", placeholder: "Thanks — we’ll get back to you shortly." %>
      <% end %>
    <% end %>

    <%= postbox "form-delivery", "Delivery" do %>
      <%= render "forms/webhook_sheet", form: form, record: @form %>
      <%= settings_field "Legacy submit URL", hint: "Optional. Only for sites that post somewhere other than the CMS." do %>
        <%= form.text_field :submit_url, class: "w-full font-mono", placeholder: "mailto:… or https://…" %>
      <% end %>
    <% end %>

    <%= postbox "form-emails", "Emails" do %>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <% FormEmail::KINDS.each do |kind| %>
          <%# herb:key kind %>
          <% email = @form.emails.find { it.kind == kind } %>
          <%= link_to edit_form_email_path(form_slug: @form.slug, kind: kind), class: "flex min-w-0 flex-col gap-1 rounded-lg border border-gray-200 px-4 py-3 hover:border-gray-300 hover:bg-gray-50" do %>
            <span class="flex items-center justify-between gap-3">
              <span class="font-medium text-gray-900"><%= kind == "notification" ? "Notification" : "Confirmation" %></span>
              <%= status_tag email&.enabled ? "On" : "Off", highlight: email&.enabled %>
            </span>
            <span class="truncate text-gray-700"><%= email&.subject.presence || "No subject yet" %></span>
            <span class="truncate text-xs text-gray-500">
              <% if kind == "notification" %>
                To: <%= email&.recipients.presence || "nobody yet" %>
              <% else %>
                To the address in: <%= email&.from_field.presence || "the first email field" %>
              <% end %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <aside class="flex shrink-0 flex-col gap-4 lg:w-80">
    <% status_field = capture do %>
      <%= settings_field "Status", hint: "Only a published form takes submissions." do %>
        <%= form.select :status, form_status_options, {}, class: "w-full" %>
      <% end %>
    <% end %>
    <%= render "layouts/shared/save_box", key: "form-publish", title: "Publish", button: "Update",
          lines: [ [ "form", "Submissions", @form.submissions.count ] ], extra: status_field,
          trash_name: "this form", trash_path: (form_path(@form.slug) if trash), trash_form: ("form_trash_form" if trash),
          trash_label: "Move to Trash" %>

    <%= postbox "form-endpoint", "Permalink" do %>
      <div class="flex min-w-0 flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Submits to</span>
        <code class="truncate rounded-md bg-gray-100 px-2 py-1 font-mono text-xs text-gray-700">/api/forms/<%= @form.slug %>/submissions</code>
        <span class="<%= ui(:help) %>">The slug, <code class="font-mono"><%= @form.slug %></code>, is the site’s key for this form, so it can’t change.</span>
      </div>
    <% end %>
  </aside>

  <%= render "forms/field_sheet", form: @form %>
<% end %>
<% if trash %>
  <%= render "layouts/shared/delete_form", id: "form_trash_form", path: form_path(@form.slug) %>
<% end %>
<%= render "content_form/postbox_state" %>
