<%# locals: (form:, record:) %>
<%# The form's own webhook, set up in a half-width sheet as Gravity Forms'
    Webhooks feed is: where it posts, and whether it sends every field or
    only the keys mapped here (FormWebhookBody). Its inputs belong to the
    form editor, so they save with it. %>
<% body = FormWebhookBody.new(record) %>
<div data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
  <div class="row row--between row--base">
    <span class="stack stack--2xs grow">
      <span class="label">Webhook</span>
      <% if record.notify_webhook_url.present? %>
        <code class="truncate text-mono text-small text-body"><%= record.notify_webhook_url %></code>
        <span class="help"><%= body.mapped? ? pluralize(body.mappings.size, "mapped key") : "Sends every field" %></span>
      <% else %>
        <span class="help">Not set up. Each submission can also be posted to a URL.</span>
      <% end %>
    </span>
    <button type="button" class="btn btn--sm no-shrink" data-action="dialog#open"><%= record.notify_webhook_url.present? ? "Edit" : "Set up" %></button>
  </div>

  <dialog class="dialog dialog--sheet dialog--sheet-half forms-webhook-sheet" data-dialog-target="dialog" aria-label="Webhook" closedby="any">
    <header class="dialog__header">
      <h2 class="heading heading--lg">Webhook</h2>
      <button type="button" class="btn btn--plain btn--sm" data-action="dialog#close">Close</button>
    </header>

    <%= settings_field "Request URL", hint: "Each submission is posted here as JSON." do %>
      <%= form.url_field :notify_webhook_url, class: "text-mono", placeholder: "https://hooks.example.com/forms" %>
    <% end %>

    <fieldset class="stack stack--sm">
      <legend class="label">Request body</legend>
      <label class="template-choice">
        <%= radio_button_tag "form[webhook_body][mode]", "all", !body.mapped?, id: nil %>
        <span class="stack stack--2xs">
          <strong class="text-medium text-ink">All fields</strong>
          <span class="help">The whole submission: the form, every answer, files, IP and time.</span>
        </span>
      </label>
      <label class="template-choice">
        <%= radio_button_tag "form[webhook_body][mode]", "fields", body.mapped?, id: nil %>
        <span class="stack stack--2xs">
          <strong class="text-medium text-ink">Select fields</strong>
          <span class="help">Only the keys below, each set to a form value or a custom one.</span>
        </span>
      </label>
    </fieldset>

    <section class="forms-webhook-map" data-controller="sortable-list" data-sortable-list-token-value="__ROW__">
      <div class="forms-webhook-map__head" aria-hidden="true">
        <span class="forms-webhook-map__cells">
          <span>Key</span>
          <span class="span-2">Value</span>
        </span>
      </div>
      <ol class="stack stack--sm" data-sortable-list-target="list">
        <% body.mappings.each_with_index do |mapping, index| %>
          <%# herb:key index %>
          <%= render "forms/webhook_mapping", mapping: mapping, key: "m" + index.to_s, record: record %>
        <% end %>
      </ol>
      <div>
        <button type="button" class="btn btn--sm" data-action="sortable-list#add">
          <%= icon_tag "add" %>
          <span>Add key</span>
        </button>
      </div>
      <p class="help">
        A custom value can take <code class="code">{{form_title}}</code>, <code class="code">{{submission_id}}</code>, <code class="code">{{submitted_at}}</code>,
        <code class="code">{{ip}}</code> or a field’s name, as <code class="code">{{email}}</code>. The fields offered are the form’s as last saved.
      </p>
      <template data-sortable-list-target="template">
        <%= render "forms/webhook_mapping", mapping: {}, key: "__ROW__", record: record %>
      </template>
    </section>

    <div class="dialog__actions">
      <button type="button" class="btn" data-action="dialog#close">Close</button>
      <%= form.button "Save", class: "btn btn--primary" %>
    </div>
  </dialog>
</div>
