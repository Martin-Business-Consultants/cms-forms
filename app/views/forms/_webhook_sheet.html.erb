<%# locals: (form:, record:) %>
<%# The form's own webhook, set up in a half-width sheet as Gravity Forms'
    Webhooks feed is: where it posts, and whether it sends every field or
    only the keys mapped here (FormWebhookBody). Its inputs belong to the
    form editor, so they save with it. %>
<% body = FormWebhookBody.new(record) %>
<div data-controller="rune-dialog" data-action="keydown.esc->rune-dialog#close:stop">
  <div class="row row--between">
    <span class="stack stack--xs grow">
      <span class="field__label">Webhook</span>
      <% if record.notify_webhook_url.present? %>
        <code class="truncate"><%= record.notify_webhook_url %></code>
        <span class="field__hint"><%= body.mapped? ? pluralize(body.mappings.size, "mapped key") : "Sends every field" %></span>
      <% else %>
        <span class="field__hint">Not set up. Each submission can also be posted to a URL.</span>
      <% end %>
    </span>
    <button type="button" class="btn btn--secondary btn--sm" data-action="rune-dialog#open"><%= record.notify_webhook_url.present? ? "Edit" : "Set up" %></button>
  </div>

  <dialog class="dialog sheet forms-webhook-sheet" data-rune-dialog-target="dialog" data-action="click->rune-dialog#backdrop" aria-label="Webhook" closedby="any">
    <div class="dialog__box">
    <header class="dialog__header">
      <h2 class="dialog__title">Webhook</h2>
      <%= icon_button "close", label: "Close", data: { action: "rune-dialog#close" } %>
    </header>

    <%= settings_field "Request URL", hint: "Each submission is posted here as JSON." do %>
      <%= form.url_field :notify_webhook_url, class: "mono", placeholder: "https://hooks.example.com/forms" %>
    <% end %>

    <fieldset class="stack stack--sm">
      <legend>Request body</legend>
      <label class="template-choice">
        <%= radio_button_tag "form[webhook_body][mode]", "all", !body.mapped?, id: nil %>
        <span class="stack stack--xs">
          <strong>All fields</strong>
          <span class="field__hint">The whole submission: the form, every answer, files, IP and time.</span>
        </span>
      </label>
      <label class="template-choice">
        <%= radio_button_tag "form[webhook_body][mode]", "fields", body.mapped?, id: nil %>
        <span class="stack stack--xs">
          <strong>Select fields</strong>
          <span class="field__hint">Only the keys below, each set to a form value or a custom one.</span>
        </span>
      </label>
    </fieldset>

    <section class="forms-webhook-map" data-controller="sortable-list" data-sortable-list-token-value="__ROW__">
      <div class="forms-webhook-map__head" aria-hidden="true">
        <span class="forms-webhook-map__cells">
          <span>Key</span>
          <span class="forms-webhook-map__wide">Value</span>
        </span>
      </div>
      <ol class="stack stack--sm" data-sortable-list-target="list">
        <% body.mappings.each_with_index do |mapping, index| %>
          <%# herb:key index %>
          <%= render "forms/webhook_mapping", mapping: mapping, key: "m" + index.to_s, record: record %>
        <% end %>
      </ol>
      <div>
        <button type="button" class="btn btn--secondary btn--sm" data-action="sortable-list#add">
          <%= icon_tag "add" %>
          <span>Add key</span>
        </button>
      </div>
      <p class="field__hint">
        A custom value can take <code>{{form_title}}</code>, <code>{{submission_id}}</code>, <code>{{submitted_at}}</code>,
        <code>{{ip}}</code> or a field’s name, as <code>{{email}}</code>. The fields offered are the form’s as last saved.
      </p>
      <template data-sortable-list-target="template">
        <%= render "forms/webhook_mapping", mapping: {}, key: "__ROW__", record: record %>
      </template>
    </section>

    <div class="dialog__actions">
      <button type="button" class="btn btn--ghost" data-action="rune-dialog#close">Close</button>
      <%= form.button "Save", class: "btn btn--primary" %>
    </div>
    </div>
  </dialog>
</div>
