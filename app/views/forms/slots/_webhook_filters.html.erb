<%# locals: (webhook:) %>
<%# Which forms send submission.created to this webhook (Webhook#matches_filters?). %>
<% forms = Form.ordered.to_a %>
<% filtered = Array(webhook.event_filters.is_a?(Hash) ? webhook.event_filters.dig("submission.created", "form_slugs") : nil) %>
<% if forms.any? %>
  <fieldset class="flex flex-col gap-2">
    <legend class="<%= ui(:label, "mb-1") %>">Which forms send submission.created</legend>
    <p class="<%= ui(:help) %>">Tick none for every form.</p>
    <% forms.each do |f| %>
      <%# herb:key f.slug %>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <%= check_box_tag "webhook[event_filters][submission.created][form_slugs][]", f.slug, filtered.include?(f.slug), id: "webhook_form_" + f.slug %>
        <%= f.title %>
      </label>
    <% end %>
  </fieldset>
<% end %>
