<%# locals: (mapping:, key:, record:) %>
<%# One row of the webhook sheet's mapping: the key the webhook receives, and
    what it takes (a field's value, a detail of the submission, or a custom
    value). Posted as form[webhook_body][mappings][<row id>][…]. %>
<% name = "form[webhook_body][mappings][" + key + "]" %>
<% fields = Array(record.fields).select { it.is_a?(Hash) && it["name"].present? } %>
<li class="webhook-map__row flex items-center gap-2" data-sortable-list-target="item">
  <span class="grid min-w-0 flex-1 grid-cols-1 gap-2 sm:grid-cols-3">
    <label class="sr-only" for="<%= "webhook_key_" + key %>">Key</label>
    <%= text_field_tag name + "[key]", mapping["key"], id: "webhook_key_" + key, class: "w-full font-mono", placeholder: "email_address",
          autocomplete: "off", spellcheck: false %>
    <label class="sr-only" for="<%= "webhook_source_" + key %>">Value</label>
    <select name="<%= name %>[source]" id="<%= "webhook_source_" + key %>" class="w-full">
      <% if fields.any? %>
        <optgroup label="Form fields">
          <% fields.each do |field| %>
            <%# herb:key field["name"] %>
            <%= tag.option field["label"].presence || field["name"], value: "field:" + field["name"], selected: mapping["source"] == "field:" + field["name"] %>
          <% end %>
        </optgroup>
      <% end %>
      <optgroup label="Submission">
        <% FormWebhookBody::META.each do |meta, label| %>
          <%# herb:key meta %>
          <%= tag.option label, value: "meta:" + meta, selected: mapping["source"] == "meta:" + meta %>
        <% end %>
      </optgroup>
      <%= tag.option "Custom value…", value: "custom", selected: mapping["source"] == "custom" %>
    </select>
    <label class="sr-only" for="<%= "webhook_value_" + key %>">Custom value</label>
    <%= text_field_tag name + "[value]", mapping["value"], id: "webhook_value_" + key, class: "webhook-map__custom w-full",
          placeholder: "Website: {{form_title}}", autocomplete: "off" %>
  </span>
  <button type="button" class="inline-flex size-8 shrink-0 items-center justify-center rounded-md text-gray-500 hover:bg-red-50 hover:text-red-700" title="Remove this key" data-action="sortable-list#remove">
    <%= icon_tag "trash", class: "size-4" %>
    <span class="sr-only">Remove this key</span>
  </button>
</li>
