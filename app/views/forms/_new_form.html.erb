<%# locals: (form_record:, open: false) %>
<%# The New form sheet: a title, a slug, a status, and optionally a template
    whose fields it starts with. It opens by itself at /forms/new (the menus
    link there) and when a submit came back with errors. %>
<% template_classes = "flex items-start gap-3 rounded-lg border border-gray-200 px-3 py-2.5 text-sm hover:bg-gray-50" %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= open %>" data-action="keydown.esc->dialog#close:stop">
  <button type="button" class="<%= ui(:button) %>" data-keys="n" data-action="dialog#open">
    <%= icon_tag "add", class: "size-4" %>
    <span class="truncate">New form</span>
    <kbd class="hidden md:inline">N</kbd>
  </button>
  <dialog class="<%= ui(:sheet) %>" data-dialog-target="dialog" aria-label="New form" closedby="any">
    <h2 class="text-lg font-semibold text-gray-900">New form</h2>
    <%= render "layouts/shared/errors", record: form_record %>
    <%= form_with model: form_record, url: forms_path, class: "flex flex-col gap-5" do |form| %>
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Title</span>
        <%= form.text_field :title, class: "w-full", placeholder: "Get in touch", autocomplete: "off" %>
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Slug</span>
        <%= form.text_field :slug, class: "w-full font-mono", placeholder: "contact", autocomplete: "off", spellcheck: false %>
        <span class="<%= ui(:help) %>">The site posts to <code class="font-mono">/api/forms/&lt;slug&gt;/submissions</code>, so it can’t change later. A template fills title and slug in when left blank.</span>
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Status</span>
        <%= form.select :status, form_status_options, {}, class: "w-full" %>
        <span class="<%= ui(:help) %>">Only a published form takes submissions.</span>
      </label>

      <fieldset class="flex flex-col gap-2">
        <legend class="<%= ui(:label, "mb-2") %>">Start from</legend>
        <label class="<%= template_classes %>">
          <%= radio_button_tag :template, "", params[:template].blank?, id: nil, class: "mt-0.5" %>
          <span>No fields yet — I’ll add them</span>
        </label>
        <% Form::TEMPLATES.each do |template| %>
          <%# herb:key template[:key] %>
          <label class="<%= template_classes %>">
            <%= radio_button_tag :template, template[:key], params[:template] == template[:key], id: nil, class: "mt-0.5" %>
            <span class="flex flex-col">
              <strong class="font-medium text-gray-900"><%= template[:name] %></strong>
              <span class="<%= ui(:help) %>"><%= template[:description] %> · <%= pluralize(template[:fields].size, "field") %></span>
            </span>
          </label>
        <% end %>
      </fieldset>

      <div class="dialog__actions flex justify-end gap-2">
        <button type="button" class="<%= ui(:button) %>" data-action="dialog#close">Cancel</button>
        <%= form.button "Create form", class: ui(:button, :primary) %>
      </div>
    <% end %>
  </dialog>
</div>
